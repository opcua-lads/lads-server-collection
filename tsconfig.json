{
    "compilerOptions": {
        "skipLibCheck": true,
        "target": "esnext",
        "esModuleInterop": true,
        "lib": ["ES2022", "DOM"],
        "module": "nodenext",
        "outDir": "./out",
        "moduleResolution": "nodenext",
        "strictNullChecks": false,
        "sourceMap": true,
        "paths": {
            "@utils": ["./utils/src"],
            "@interfaces": ["./interfaces/src"],
            "@afo": ["./lib/afo/src"],
            "@afo/*": ["./lib/afo/src/*"],
            "@asm": ["./lib/asm/src"],
        }
    },
}
